@model CarRentalApp.Models.Car

@{
    ViewData["Title"] = $"{Model.Make} {Model.Model} - Szczegóły";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Flota</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Make @Model.Model</li>
        </ol>
    </nav>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-lg-7 bg-light d-flex align-items-center justify-content-center border-end">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 450px;" alt="@Model.Make @Model.Model">
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-image text-muted" style="font-size: 10rem;"></i>
                        <p class="text-muted">Brak dostępnego zdjęcia</p>
                    </div>
                }
            </div>

            <div class="col-lg-5 p-4 p-md-5 d-flex flex-column justify-content-center">
                <div class="mb-4">
                    <span class="badge bg-primary px-3 py-2 rounded-pill mb-2">@Model.Category?.Name</span>
                    <h1 class="display-5 fw-bold text-dark mb-0">@Model.Make</h1>
                    <h2 class="h3 text-muted fw-light">@Model.Model</h2>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="bg-light p-3 rounded-3 me-3 text-primary">
                                <i class="bi bi-calendar-event fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Rok produkcji</small>
                                <span class="fw-bold fs-5">@Model.Year</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="bg-light p-3 rounded-3 me-3 text-success">
                                <i class="bi bi-currency-dollar fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Cena / doba</small>
                                <span class="fw-bold fs-5">@Model.PricePerDay zł</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-3">
                    <a href="#" class="btn btn-primary btn-lg rounded-pill shadow-sm py-3 fw-bold">
                        <i class="bi bi-calendar-check me-2"></i>Zarezerwuj teraz
                    </a>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1">
                            <i class="bi bi-arrow-left me-1"></i> Powrót
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-dark rounded-pill px-4">
                                <i class="bi bi-pencil-square"></i> Edytuj
                            </a>
                        }
                    </div>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 small border">
                        <p class="mb-0 text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Jesteś zalogowany jako Administrator. Masz pełny dostęp do zarządzania tym pojazdem.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Delikatna animacja wejścia */
    .container {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>