@model IEnumerable<CarRentalApp.Models.Car>

@{
    ViewData["Title"] = "Nasza Flota";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold text-dark">Dostępne Samochody</h1>
            <p class="text-muted">Wybierz pojazd dopasowany do Twoich potrzeb</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm rounded-pill px-4">
                <i class="bi bi-plus-circle-fill me-2"></i>Dodaj nowy pojazd
            </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Make @item.Model" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 220px;">
                                <i class="bi bi-camera fs-1"></i>
                            </div>
                        }
                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-primary px-3 py-2 shadow-sm">
                            @item.Year
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title fw-bold mb-0">@item.Make @item.Model</h5>
                                <small class="text-muted"><i class="bi bi-tag-fill me-1"></i>@item.Category?.Name</small>
                            </div>
                            <div class="text-end">
                                <span class="d-block h5 text-primary fw-bold mb-0">@item.PricePerDay zł</span>
                                <small class="text-muted">/ doba</small>
                            </div>
                        </div>

                        <hr class="my-3 opacity-25">

                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark rounded-pill">
                                <i class="bi bi-info-circle me-1"></i> Szczegóły
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="btn-group w-100 mt-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edytuj
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Usuń
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.3s ease, shadow 0.3s ease;
    }

        .transition-hover:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }
</style>