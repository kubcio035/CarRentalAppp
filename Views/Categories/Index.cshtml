@model IEnumerable<CarRentalApp.Models.Category>

@{
    ViewData["Title"] = "Zarządzanie Kategoriami";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-0">Kategorie Pojazdów</h1>
            <p class="text-muted">Zarządzaj typami samochodów dostępnymi w Twojej flocie</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-folder-plus me-2"></i>Dodaj nową
            </a>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-7 text-muted fw-bold" style="letter-spacing: 1px;">
                            <i class="bi bi-tag me-2"></i>Nazwa Kategorii
                        </th>
                        <th class="text-end pe-4 py-3 text-uppercase fs-7 text-muted fw-bold" style="letter-spacing: 1px;">
                            Akcje
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3">
                                        <i class="bi bi-collection-fill"></i>
                                    </div>
                                    <span class="fw-semibold text-dark fs-5">@item.Name</span>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-3 overflow-hidden">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm border" title="Szczegóły">
                                        <i class="bi bi-eye text-primary"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm border" title="Edytuj">
                                            <i class="bi bi-pencil text-warning"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white btn-sm border" title="Usuń">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Brak zdefiniowanych kategorii.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 p-3 bg-light rounded-3 border-start border-primary border-4 shadow-sm">
        <small class="text-muted">
            <i class="bi bi-info-circle-fill text-primary me-2"></i>
            Kategorie pomagają użytkownikom szybciej filtrować auta. Pamiętaj, aby nazwy były krótkie i zrozumiałe.
        </small>
    </div>
</div>

<style>
    .table thead th {
        font-size: 0.75rem;
    }

    .btn-white {
        background-color: #fff;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }
    /* Efekt po najechaniu na wiersz */
    tr {
        transition: background-color 0.2s ease;
    }
</style>