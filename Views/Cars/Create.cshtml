@model CarRentalApp.Models.Car

@{
    ViewData["Title"] = "Dodaj Nowy Samochód";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Flota</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dodawanie pojazdu</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-3">
                    <h4 class="mb-0 text-white fw-bold"><i class="bi bi-plus-lg me-2"></i>Dodaj nowy samochód do bazy</h4>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-md-7">
                                <h5 class="text-primary border-bottom pb-2 mb-4">Informacje podstawowe</h5>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Make" class="form-label fw-semibold">Marka</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i class="bi bi-car-front text-muted"></i></span>
                                            <input asp-for="Make" class="form-control" placeholder="np. BMW" />
                                        </div>
                                        <span asp-validation-for="Make" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Model" class="form-label fw-semibold">Model</label>
                                        <input asp-for="Model" class="form-control" placeholder="np. M4" />
                                        <span asp-validation-for="Model" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Year" class="form-label fw-semibold">Rok produkcji</label>
                                        <input asp-for="Year" class="form-control" type="number" />
                                        <span asp-validation-for="Year" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="CategoryId" class="form-label fw-semibold">Kategoria</label>
                                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                            <option value="">-- Wybierz kategorię --</option>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="PricePerDay" class="form-label fw-semibold">Cena za dobę (zł)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light">PLN</span>
                                            <input asp-for="PricePerDay" class="form-control" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <h5 class="text-primary border-bottom pb-2 mb-4">Wygląd zewnętrzny</h5>

                                <div class="mb-4">
                                    <label asp-for="ImageUrl" class="form-label fw-semibold">Link do zdjęcia</label>
                                    <input asp-for="ImageUrl" class="form-control" id="imageUrlInput" placeholder="https://..." />
                                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                                    <div class="form-text mt-2">Wklej bezpośredni link do pliku JPG/PNG.</div>
                                </div>

                                <div class="preview-container bg-light rounded-3 d-flex align-items-center justify-content-center border" style="height: 250px; overflow: hidden;">
                                    <img id="imagePreview" src="" alt="Podgląd" class="img-fluid d-none" style="object-fit: cover; width: 100%; height: 100%;">
                                    <div id="imagePlaceholder" class="text-center text-muted">
                                        <i class="bi bi-image fs-1 d-block mb-2"></i>
                                        <span>Podgląd zdjęcia</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3 border-top pt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i>Utwórz pojazd
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Skrypt do podglądu zdjęcia na żywo
        const input = document.getElementById('imageUrlInput');
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('imagePlaceholder');

        input.addEventListener('input', function() {
            if (this.value && this.value.length > 5) {
                preview.src = this.value;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            } else {
                preview.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }
        });

        // Obsługa błędów ładowania obrazka
        preview.onerror = function() {
            preview.classList.add('d-none');
            placeholder.classList.remove('d-none');
            placeholder.innerHTML = '<i class="bi bi-exclamation-triangle fs-1 d-block mb-2 text-warning"></i><span>Niepoprawny format obrazka</span>';
        };
    </script>
}